# Copy to .env.local and fill in. These values are public (client IDs and
# scopes only). Never put a client secret in the frontend.
# NEXT_PUBLIC_* values are built into the app, so rebuild after changing them.

# ---- Sign-in ----
# preview = simulated sign-in (default) | entra = Microsoft Entra via MSAL
NEXT_PUBLIC_AUTH_MODE=preview

# Frontend app registration (type: Single-page application)
NEXT_PUBLIC_ENTRA_CLIENT_ID=
# Shield's Directory (tenant) ID
NEXT_PUBLIC_ENTRA_TENANT_ID=
# Scope exposed by the API app registration, e.g. api://<api-client-id>/access_as_user
NEXT_PUBLIC_ENTRA_API_SCOPE=
# Optional. Defaults to the site address (e.g. http://localhost:3000)
NEXT_PUBLIC_ENTRA_REDIRECT_URI=

# ---- Data ----
# local = projects saved in the browser (default) | api = ASP.NET Core Project API
NEXT_PUBLIC_DATA_MODE=local
# Backend address, no trailing slash, e.g. https://localhost:7001 or https://spfm-api.azurewebsites.net
NEXT_PUBLIC_API_BASE_URL=
